# Build from app/pkgbuild inside an omaplace source checkout (it uses the plugin's js/ next to it).
pkgname=omaplace-settings
pkgver=0.3.0
pkgrel=8
pkgdesc='Settings app for the omaplace Omarchy plugin'
arch=('x86_64' 'aarch64')
url='https://github.com/felipecpaiva/omaplace'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make' 'python')
optdepends=('omarchy-shell: talks to the omaplace plugin')
source=()
sha256sums=()
build() {
  mkdir -p "$startdir/../build"
  cd "$startdir/../build"
  qmake6 "$startdir/../omaplace-settings.pro"
  make
}
package() {
  install -Dm755 "$startdir/../build/omaplace-settings" "$pkgdir/usr/bin/omaplace-settings"
  install -Dm644 "$startdir/../omaplace-settings.desktop" "$pkgdir/usr/share/applications/omaplace-settings.desktop"
  install -Dm644 "$startdir/../omaplace-settings.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omaplace-settings.svg"
  install -Dm644 "$startdir/../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
