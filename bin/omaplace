#!/usr/bin/env bash
# omaplace command line (design 7.3). Maps words to the service's IPC methods and prints the answer.
# Exit codes: 0 ok (also a picker closed without a choice), 2 bad usage, 3 not found or nothing to save, 4 partial,
# 5 failed, 6 Lua module not loaded, 7 plan not updated (the move does not fit the plan).
set -euo pipefail

target=io.github.felipecpaiva.omaplace
runtime="${XDG_RUNTIME_DIR:-/run/user/$UID}/omaplace"
config="${XDG_CONFIG_HOME:-$HOME/.config}/omaplace/config.toml"

usage() {
  cat <<'USAGE'
Usage: omaplace [--json] <command>

  save <name>           save the focused desktop as a scene
  save --ask            ask for the name in the Omarchy menu (Enter alone: the desktop's name)
  open <name>           open a scene on the focused desktop
  open --pick           pick the scene from a list in the Omarchy menu
  restore [generation]  restore the last session
  list                  list scenes
  rename <from> <to>    rename a scene
  remove <name>         delete a scene
  rule add              add a rule for the focused window (its desktop and monitor)
  rule remove <name>    delete a rule
  status                show the current or last run
  plan-update <id>      write a hand move of a planned window into its plan (the "Update plan" notification button)
  settings              open the settings window

  --json                print the service's JSON answer instead of text
Exit codes: 0 ok (also a picker closed without a choice), 2 bad usage, 3 not found or nothing to save,
4 partial, 5 failed, 6 Lua module not loaded, 7 plan not updated (the move does not fit the plan).
USAGE
}
bad() { echo "omaplace: $1" >&2; usage >&2; exit 2; }

json=0
if [ "${1:-}" = "--json" ]; then json=1; shift; fi
[ $# -gt 0 ] || bad "a command is needed"
word=$1; shift
need() { [ "$1" -eq "$2" ] || bad "$word takes $2 argument(s)"; }

# Started from the Omarchy menu or a notification button there is no terminal: show the answer of save, rule and
# plan-update as a notification instead.
# (open and restore already send their own summary from the service.)
if [ "${OMAPLACE_NOTIFY:-1}" != 0 ] && [ ! -t 1 ] && [ ! -t 2 ] && { [ "$word" = save ] || [ "$word" = rule ] || [ "$word" = plan-update ]; } && command -v omarchy-notification-send >/dev/null; then
  quiet_out=$(mktemp)
  exec >"$quiet_out" 2>&1
  trap 'omarchy-notification-send -g "󰕰" "omaplace" "$(head -c 300 "$quiet_out")" >/dev/null 2>&1; rm -f -- "$quiet_out"' EXIT
fi

# The menu rows (WP8): the name comes from Omarchy's pickers. Closing a picker exits 0 and does nothing.
if [ "$word" = save ] && [ "${1:-}" = --ask ] && [ $# -eq 1 ]; then
  ws=$(hyprctl activeworkspace -j 2>/dev/null | sed -n -E 's/.*"name": *"([^"]*)".*/\1/p' | head -n1 | tr 'A-Z' 'a-z' | tr -c 'a-z0-9_\n-' '-' | cut -c1-40 || true)
  name=$(omarchy-menu-input "Scene name${ws:+ (Enter for $ws)}") || exit 0
  set -- "${name:-$ws}"
  [ -n "$1" ] || bad "a scene name is needed"
elif [ "$word" = open ] && [ "${1:-}" = --pick ] && [ $# -eq 1 ]; then
  listed=$(omarchy-shell "$target" list) || { echo "omaplace: the omaplace service is not reachable (is the plugin installed and enabled?)" >&2; exit 5; }
  mapfile -t names < <(grep -oE '"name":"[^"]*"' <<< "$listed" | sed -E 's/"name":"([^"]*)"/\1/')
  [ ${#names[@]} -gt 0 ] || { echo "omaplace: no scenes yet, save one first" >&2; exit 3; }
  name=$(omarchy-menu-select "Open a scene" "${names[@]}") || exit 0
  [ -n "$name" ] || exit 0
  set -- "$name"
fi

case $word in
  -h | --help | help) usage; exit 0 ;;
  save | open | remove) need $# 1; args=("$word" "$1") ;;
  restore) [ $# -le 1 ] || bad "restore takes at most 1 argument"; args=(restore "${1:-}") ;;
  rename) need $# 2; args=(rename "$1" "$2") ;;
  list | status | settings) need $# 0; args=("$word") ;;
  plan-update) need $# 1; [[ $1 =~ ^[0-9]+$ ]] || bad "plan-update takes a move id (a number)"; args=(planUpdate "$1") ;;
  rule)
    case "${1:-}" in
      add) shift; need $# 0; args=(ruleAddFocused) ;;
      remove) shift; need $# 1; args=(ruleRemove "$1") ;;
      *) bad "rule add | rule remove <name>" ;;
    esac ;;
  *) bad "unknown command: $word" ;;
esac

field() { # field <json> <key>: a string (whole, commas and escaped quotes too) or number value, empty when absent
  local v
  v=$(sed -n -E 's/.*"'"$2"'":"(([^"\\]|\\.)*)".*/\1/p' <<< "$1" | head -n1)
  [ -n "$v" ] || v=$(sed -n -E 's/.*"'"$2"'":([^",}]*).*/\1/p' <<< "$1" | head -n1)
  printf '%s\n' "$v" | sed -E 's/\\(["\\])/\1/g'
}

answer=$(omarchy-shell "$target" "${args[@]}") || {
  echo "omaplace: the omaplace service is not reachable (is the plugin installed and enabled?)" >&2
  exit 5
}

# A slow request answers pending at once; its result lands in result-<req>.json.
if [[ $answer == *'"pending":true'* ]]; then
  req=$(field "$answer" req)
  [[ $req =~ ^[A-Za-z0-9_-]+$ ]] || { echo "omaplace: bad answer from the service" >&2; exit 5; }
  file="$runtime/result-$req.json"
  limit=$(grep -m1 -E '^[[:space:]]*request_timeout_s[[:space:]]*=[[:space:]]*[0-9]+' "$config" 2>/dev/null | grep -oE '[0-9]+$' || true)
  limit=${limit:-60}
  start=$SECONDS
  while [ ! -f "$file" ]; do
    [ $((SECONDS - start)) -lt "$limit" ] || { echo "omaplace: no answer after ${limit} s" >&2; exit 5; }
    if [ -d "$runtime" ] && command -v inotifywait >/dev/null 2>&1; then
      inotifywait -qq -t 1 -e moved_to -e close_write "$runtime" >/dev/null 2>&1 || true
    else
      sleep 0.2
    fi
  done
  answer=$(cat "$file")
fi

if [ "$json" = 1 ]; then printf '%s\n' "$answer"; fi
ok=$(field "$answer" ok)
code=$(field "$answer" code)
state=$(field "$answer" state)

if [ "$ok" != true ]; then
  case $code in
    not_found) [ "$json" = 1 ] || { reason=$(field "$answer" reason); echo "omaplace: not found${reason:+ ($reason)}" >&2; }; exit 3 ;;
    bad_name) [ "$json" = 1 ] || echo "omaplace: names are 1 to 40 of a-z, 0-9, _ and -" >&2; exit 2 ;;
    empty) [ "$json" = 1 ] || echo "omaplace: nothing to save on this desktop" >&2; exit 3 ;;
    not_possible) [ "$json" = 1 ] || echo "omaplace: plan not updated: $(field "$answer" reason)" >&2; exit 7 ;;
    no_lua)
      if [ "$json" = 0 ]; then
        echo "omaplace: the Lua module is not loaded. Add this line to ~/.config/hypr/hyprland.lua:" >&2
        echo '  pcall(dofile, os.getenv("HOME") .. "/.config/omarchy/plugins/io.github.felipecpaiva.omaplace/lua/omaplace.lua")' >&2
      fi
      exit 6 ;;
    *) [ "$json" = 1 ] || echo "omaplace: failed (${code:-unknown}$([ -n "$state" ] && echo ", $state"))" >&2; exit 5 ;;
  esac
fi

if [ "$json" = 0 ]; then
  n() { local v; v=$(field "$answer" "$1"); echo "${v:-0}"; }
  case $word in
    save) echo "saved ${args[1]}: $(n saved) windows, $(n skipped) skipped, $(n need_profile) need a profile" ;;
    open) echo "opened ${args[1]}: $(n placed) placed ($(n started) started), $(n skipped) skipped, $(n not_reopened) not reopened, $(n failed) failed" ;;
    restore) echo "restored the last session: $(n placed) placed ($(n started) started), $(n skipped) skipped, $(n not_reopened) not reopened, $(n failed) failed" ;;
    list) grep -oE '"name":"[^"]*","windows":[0-9]+' <<< "$answer" | sed -E 's/"name":"([^"]*)","windows":([0-9]+)/\1  \2 windows/' || true ;;
    status) echo "run: $(field "$answer" run) ${state:-idle}" ;;
    plan-update) [ "$(field "$answer" changed)" = true ] && echo "plan $(field "$answer" scene) updated" || echo "the plan already says so" ;;
    rule) [ "${args[0]}" = ruleAddFocused ] && echo "rule added: $(field "$answer" rule)" || echo "rule removed" ;;
    *) echo "ok" ;;
  esac
fi
case $word in save | open | restore) [ "$state" != partial ] || exit 4 ;; esac
exit 0
